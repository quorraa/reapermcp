  "items": [
    {
      "id": "cinematic",
      "name": "Cinematic",
      "parent": "common_practice",
      "summary": "Tonal grammar widened by chromatic mediants, mixture, pedals and wide orchestral spacing, with contrast built from register and density rather than from cadences.",
      "harmonic_vocabulary": {
        "core": [
          "major_triad",
          "minor_triad",
          "major7",
          "minor7",
          "sus2",
          "sus4",
          "add9",
          "minor9",
          "power"
        ],
        "occasional": [
          "dominant7",
          "diminished7",
          "half_diminished7",
          "augmented_triad",
          "german_sixth",
          "italian_sixth",
          "french_sixth",
          "major7_sharp11",
          "minor_major7"
        ],
        "avoided": [
          "dominant13_sharp11",
          "six_nine",
          "minor13",
          "add2"
        ]
      },
      "functional_strength": 0.55,
      "modal_tolerance": 0.7,
      "chromaticism_preference": 0.7,
      "extension_density": 0.3,
      "alteration_preference": 0.3,
      "harmonic_rhythm": {
