        "max_slot_qn": "16",
        "coupled_to_tempo": false
      },
      "voice_leading_strictness": 0.6,
      "parallel_motion_treatment": "penalised",
      "dissonance_treatment": "free",
      "register_spacing": {
        "open_voicing_bias": 0.8,
        "low_interval_limit_source": "instrument_profile",
        "min_top_spacing_semitones": 2,
        "max_outer_voice_span_semitones": 36
      },
      "bass_behavior": {
        "allowed_modes": [
          "roots",
          "pedal",
          "stepwise",
          "inversions",
          "contrary_motion"
        ],
        "default_mode": "pedal",
        "octave_folding": false,
        "ornamentation": "passing_tones"
      },
      "countermelody_density": 0.45,
      "arrangement_density": 0.6,
      "loop_preference": {
        "default_intent": "transition_ready",
        "allowed_intents": [
          "closed_tonic",
          "open_dominant",
          "modal_drone",
          "seamless_color",
          "transition_ready",
          "one_shot_ending"
        ],
        "wrap_weight": 0.6,
        "tail_policy": "sustain"
      },
      "candidate_diversity": 0.7,
      "default_complexity": 0.5,
      "score_weights": {
        "melody_fit": 1.2,
        "harmonic_coherence": 1.2,
        "functional_or_modal_coherence": 0.8,
        "voice_leading": 1.2,
        "extension_appropriateness": 0.6,
        "style_match": 1.4,
        "phrase_direction": 1.1,
        "bass_quality": 1.0,
        "arrangement_clarity": 1.5,
        "loop_compatibility": 0.6,
        "complexity_target": 1.0,
        "chromaticism_target": 1.3,
        "candidate_diversity": 1.0
      },
      "rule_overrides": {
        "harmony.chromatic_mediant_is_not_diatonic": 1.8,
        "harmony.borrowed_chord_comes_from_parallel_mode": 1.4,
        "harmony.augmented_sixth_expands_outward": 1.2,
        "harmony.ii_v_i_is_preferred_cadential_path": 0.6,
        "harmony.pedal_slows_harmonic_rhythm": 1.5,
        "arrangement.roles_occupy_separate_registers": 1.5,
        "arrangement.contrast_beyond_dynamics": 1.6,
        "voice_leading.upper_voices_within_an_octave": 0.4,
        "voice_leading.direct_perfect_in_outer_voices": 0.3,
        "counterpoint.dissonance_is_prepared": 0.4
