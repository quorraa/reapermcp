  "items": [
    {
      "id": "extensions.major_natural_11_close_register",
      "domain": "extensions",
      "kind": "style_sensitive_preference",
      "summary": "A natural 11 close to a major third can create a strong minor-ninth clash.",
      "trigger": {
        "event": "voicing_built",
        "chord_family": "major",
        "contains_degrees": [
          "3",
          "11"
        ]
      },
      "conditions": [
        "third_and_eleventh_are_in_adjacent_or_close_registers",
        "third_is_not_suspended",
        "cluster_intent_is_false"
      ],
      "effect": {
        "score_delta": -2.5,
        "severity": "moderate",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "common_practice",
        "jazz_standard",
        "pop_rock",
        "cinematic"
      ],
      "exceptions": [
        "melody_is_11",
        "third_is_omitted",
        "voices_are_widely_spaced",
        "intentional_cluster",
        "quartal_or_planing_context"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
      ],
      "confidence": 0.95,
      "rationale": "Treat this as a voicing and register issue, not a universal ban on major-eleventh harmony.",
      "test_ids": [
        "major11_close_register_penalty",
        "major11_omit3_exception",
        "major11_melody_exception"
      ],
      "version": 1
    },
    {
      "id": "extensions.sharp_eleven_preferred_over_natural_eleven",
      "domain": "extensions",
      "kind": "theory_default",
      "summary": "On a major-family chord the raised eleventh is the default colour because it sits a whole step above the third instead of a half step.",
      "trigger": {
        "event": "chord_selected",
        "chord_family": "major",
        "contains_degrees": [
          "11"
        ]
      },
      "conditions": [
        "chord_has_altered_tones"
      ],
      "effect": {
        "score_delta": 2.0,
        "severity": "moderate",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "jazz_standard",
        "neo_soul_rnb",
        "cinematic",
        "modal_ambient",
        "pop_rock"
      ],
      "exceptions": [
        "melody_is_11",
        "third_is_suspended"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
      ],
      "confidence": 0.85,
      "rationale": "The raised eleventh gives the Lydian colour without the clash, which is why it is far more common on major seventh chords than the natural eleventh.",
      "test_ids": [
        "sharp11_distinct_from_natural11",
        "sharp11_preferred_on_major7"
      ],
      "version": 1
    },
    {
      "id": "extensions.minor_eleven_is_consonant",
      "domain": "extensions",
      "kind": "theory_default",
      "summary": "The natural eleventh over a minor chord is a perfect fourth above the minor third and needs no special treatment.",
      "trigger": {
        "event": "chord_selected",
        "chord_family": "minor",
        "contains_degrees": [
          "11"
        ]
      },
      "conditions": [
        "seventh_is_present"
      ],
      "effect": {
        "score_delta": 1.5,
        "severity": "minor",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
      ],
      "confidence": 0.9,
      "rationale": "The register-sensitive clash rule is specific to the major third. Applying it to minor chords would remove one of the most common modal colours there is.",
      "test_ids": [
        "minor11_no_penalty",
        "minor11_default_modal_color"
      ],
      "version": 1
    },
    {
      "id": "extensions.alteration_requires_destination",
      "domain": "extensions",
      "kind": "strong_theory_principle",
      "summary": "Which alterations a dominant carries must be chosen from its destination, its melody and its voice-leading path.",
      "trigger": {
        "event": "chord_selected",
        "chord_family": "dominant"
      },
      "conditions": [
        "chord_has_altered_tones"
      ],
      "effect": {
        "score_delta": -3.0,
        "severity": "major",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "jazz_standard",
        "neo_soul_rnb",
        "cinematic",
        "common_practice",
        "blues"
      ],
      "exceptions": [
        "target_chord_follows",
        "altered_tone_resolves_by_step"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
      ],
      "confidence": 0.9,
      "rationale": "An alteration that does not resolve into the next chord is decoration without a consequence, and it is the fastest way to make generated jazz harmony sound arbitrary.",
      "test_ids": [
        "altered_tension_connects_to_destination",
        "unresolved_alteration_penalised"
      ],
      "version": 1
    },
    {
      "id": "extensions.alt_expands_to_explicit_alternatives",
      "domain": "extensions",
      "kind": "hard_integrity",
      "summary": "The 'alt' marker denotes a family; the engine must expand it into explicit, spelled alternatives rather than substituting one fixed collection.",
      "trigger": {
        "event": "symbol_parsed",
        "chord_family": "dominant"
      },
      "conditions": [
        "chord_has_altered_tones"
      ],
      "effect": {
        "score_delta": -6.0,
        "severity": "major",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "common_practice",
