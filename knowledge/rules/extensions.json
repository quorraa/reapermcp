        "event": "chord_pair",
        "chord_family": "dominant",
        "contains_degrees": [
          "b9"
        ]
      },
      "conditions": [
        "target_chord_follows",
        "key_is_minor"
      ],
      "effect": {
        "score_delta": 2.0,
        "severity": "moderate",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "jazz_standard",
        "neo_soul_rnb",
        "cinematic",
        "common_practice",
        "blues"
      ],
      "exceptions": [
        "chromaticism_target_is_high"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
