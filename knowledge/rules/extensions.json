    {
      "id": "extensions.flat_thirteen_conflicts_with_natural_fifth",
      "domain": "extensions",
      "kind": "theory_default",
      "summary": "A flat thirteenth and a natural fifth sounding together are a half-step clash rather than a colour; omit the fifth.",
      "trigger": {
        "event": "voicing_built",
        "chord_family": "dominant",
        "contains_degrees": [
          "5",
          "b13"
        ]
      },
      "conditions": [
        "chord_has_altered_tones"
      ],
      "effect": {
        "score_delta": -3.0,
        "severity": "moderate",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "fifth_is_omitted",
        "voices_are_widely_spaced",
        "intentional_cluster"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
      ],
      "confidence": 0.9,
      "rationale": "This is the one alteration conflict that is close to categorical: the two notes are a semitone apart in the same register and neither is a guide tone.",
      "test_ids": [
        "b13_omits_natural_fifth"
      ],
      "version": 1
    },
    {
      "id": "extensions.sharp_nine_separated_from_major_third",
      "domain": "extensions",
      "kind": "style_sensitive_preference",
      "summary": "The raised ninth is the blues minor third against the chord's major third and needs register separation.",
      "trigger": {
        "event": "voicing_built",
        "chord_family": "dominant",
        "contains_degrees": [
          "3",
          "#9"
        ]
      },
      "conditions": [
        "register_is_low"
      ],
      "effect": {
        "score_delta": -2.0,
        "severity": "moderate",
        "score_component": "extension_appropriateness"
      },
      "profiles": [
        "jazz_standard",
        "neo_soul_rnb",
        "cinematic",
        "pop_rock"
      ],
      "exceptions": [
        "voices_are_widely_spaced",
        "melody_is_altered_tone",
        "intentional_cluster",
        "register_is_high"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
      ],
      "confidence": 0.8,
      "rationale": "Voiced a ninth or more apart the two thirds are the characteristic sound; voiced a semitone apart in the lower middle register they are mud.",
      "test_ids": [
        "sharp9_needs_register_separation",
        "sharp9_on_top_is_fine"
      ],
      "version": 1
    },
    {
      "id": "extensions.flat_nine_prefers_minor_destination",
      "domain": "extensions",
      "kind": "theory_default",
      "summary": "A flat ninth on a dominant fits best when the target chord is minor, because the alteration falls into a chord tone of the target.",
