        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Altered and extended chords"
        }
