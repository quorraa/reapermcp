        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [],
      "confidence": 0.7,
      "rationale": "Forcing a single label on ambiguous material hides exactly the information a user needs in order to disagree with the analysis.",
      "test_ids": [
        "ambiguous_tone_multiple_hypotheses"
      ],
      "version": 1
    },
    {
      "id": "melody.single_climax_per_phrase",
      "domain": "melody",
      "kind": "style_sensitive_preference",
      "summary": "A generated phrase should reach its registral peak once.",
      "trigger": {
        "event": "melody_phrase"
      },
      "conditions": [
        "melody_reaches_registral_peak"
      ],
      "effect": {
        "score_delta": 1.5,
        "severity": "minor",
        "score_component": "phrase_direction"
      },
