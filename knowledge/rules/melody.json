      "version": 1
    },
    {
      "id": "melody.ambiguous_tone_keeps_multiple_hypotheses",
      "domain": "melody",
      "kind": "implementation_heuristic",
      "summary": "When two non-chord-tone classifications score within a small margin, both are reported with confidence values instead of one being silently chosen.",
      "trigger": {
        "event": "nct_hypothesis"
      },
      "conditions": [
        "dissonance_is_on_strong_beat",
        "note_is_approached_by_step"
      ],
      "effect": {
        "score_delta": 0.0,
        "severity": "info",
        "score_component": "melody_fit"
      },
      "profiles": [
        "common_practice",
