      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Melodic analysis"
        }
      ],
      "confidence": 0.65,
      "rationale": "A single high point gives a phrase a shape; repeated peaks flatten it. This is a generation preference and is never applied to the user's own melody.",
      "test_ids": [
        "phrase_has_single_climax"
      ],
      "version": 1
    }
  ]
