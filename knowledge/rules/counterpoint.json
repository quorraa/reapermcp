      "profiles": [
        "strict_counterpoint",
        "common_practice"
      ],
      "exceptions": [
        "note_is_left_by_step",
        "modal_center_is_active",
        "chromaticism_target_is_high"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Counterpoint"
        }
