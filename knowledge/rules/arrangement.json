        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Formal contrast"
        }
