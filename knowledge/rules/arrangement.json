    {
      "id": "arrangement.contrast_beyond_dynamics",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "Section contrast must use register, rhythm, density, texture, harmony, articulation or silence, not velocity alone.",
