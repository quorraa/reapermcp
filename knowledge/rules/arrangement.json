    {
      "id": "arrangement.foreground_role_wins_contested_register",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "When two parts contest a register, the one with higher priority keeps it and the other is moved.",
      "trigger": {
        "event": "arrangement_plan"
      },
      "conditions": [
        "register_overlaps_another_part",
        "role_is_lead"
      ],
      "effect": {
        "score_delta": 2.0,
        "severity": "moderate",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "berklee-orchestration-2",
          "locator": "Course description"
        }
      ],
      "confidence": 0.8,
      "rationale": "An explicit priority order makes conflict resolution deterministic, which matters as much as the musical result because the same input must always produce the same arrangement.",
      "test_ids": [
        "foreground_priority_resolves_conflict"
      ],
      "version": 1
    },
    {
      "id": "arrangement.transition_fill_precedes_section_change",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "A transition fill belongs in the last half bar before a section boundary.",
      "trigger": {
        "event": "arrangement_plan"
      },
      "conditions": [
        "cadence_is_expected_at_this_slot"
      ],
      "effect": {
        "score_delta": 1.5,
        "severity": "minor",
        "score_component": "phrase_direction"
      },
      "profiles": [
        "pop_rock",
        "electronic_loop",
        "drum_and_bass",
        "cinematic",
        "neo_soul_rnb"
      ],
      "exceptions": [
        "is_loop_wrap_boundary"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Formal contrast"
        }
      ],
      "confidence": 0.7,
      "rationale": "A fill placed anywhere else reads as an error rather than a signal. It is also excluded from loop-repeatability scoring because it deliberately breaks the pattern.",
      "test_ids": [
        "transition_fill_before_boundary"
      ],
      "version": 1
    },
    {
      "id": "arrangement.energy_curve_is_respected",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "Layer count, register span and onset density should follow the requested energy curve.",
      "trigger": {
        "event": "arrangement_plan"
      },
      "conditions": [
        "part_density_exceeds_role_target"
      ],
      "effect": {
        "score_delta": -2.0,
        "severity": "moderate",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
