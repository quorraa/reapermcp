{
  "schema_version": "1.0.0",
  "items": [
    {
      "id": "arrangement.roles_occupy_separate_registers",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "Two parts with different roles should not share the same register window.",
      "trigger": {
        "event": "arrangement_plan"
      },
      "conditions": [
        "register_overlaps_another_part"
      ],
      "effect": {
        "score_delta": -3.0,
        "severity": "moderate",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "doubling_is_allowed_for_role",
        "role_is_pad_or_sustained"
      ],
      "source_refs": [
        {
          "source_id": "berklee-orchestration-2",
          "locator": "Course description"
        },
        {
          "source_id": "mt21c",
          "locator": "Texture and accompaniment patterns"
        }
      ],
      "confidence": 0.8,
      "rationale": "Masking is a register problem before it is a level problem, and register is the only control available in a MIDI-only version-one product.",
      "test_ids": [
        "register_separation_reduces_collisions",
        "roles_produce_distinct_parts"
      ],
      "version": 1
    },
    {
      "id": "arrangement.background_parts_avoid_lead_onsets",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "A background part whose onsets consistently coincide with the lead's competes for attention.",
      "trigger": {
        "event": "part_generated"
      },
      "conditions": [
        "onsets_collide_with_higher_priority_role"
      ],
      "effect": {
        "score_delta": -2.5,
        "severity": "moderate",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "doubling_is_allowed_for_role",
        "role_is_lead"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Texture and accompaniment patterns"
        }
      ],
      "confidence": 0.8,
      "rationale": "Offbeat and afterbeat comping patterns exist precisely to solve this, which is why they are the default accompaniment shapes in most profiles.",
      "test_ids": [
        "background_avoids_lead_onsets",
        "offbeat_comping_reduces_collision"
      ],
      "version": 1
    },
    {
      "id": "arrangement.density_matches_role_target",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "Each part's onset density should stay within the budget declared by its arrangement pattern.",
      "trigger": {
        "event": "part_generated"
      },
      "conditions": [
        "part_density_exceeds_role_target"
      ],
      "effect": {
        "score_delta": -2.5,
        "severity": "moderate",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "complexity_target_is_high"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Texture and accompaniment patterns"
        }
      ],
      "confidence": 0.75,
      "rationale": "Density is the arrangement parameter users notice first. Tying it to the pattern makes the density control audibly effective instead of a vague nudge.",
      "test_ids": [
        "density_setting_changes_note_density",
        "sparse_profile_contains_rests"
      ],
      "version": 1
    },
    {
      "id": "arrangement.pad_sustains_common_tones",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "A pad should tie common tones across chord changes rather than re-articulate every voice.",
      "trigger": {
        "event": "part_generated",
        "role": "pad"
      },
      "conditions": [
        "role_is_pad_or_sustained",
        "common_tone_available"
      ],
      "effect": {
        "score_delta": 2.5,
        "severity": "moderate",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "harmonic_rhythm_is_fast"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Texture and accompaniment patterns"
        }
      ],
      "confidence": 0.8,
      "rationale": "A pad that re-strikes on every chord is a block-chord part with a slow attack. Tying common tones is what makes the texture continuous.",
      "test_ids": [
        "pad_produces_sustained_behavior",
        "pad_ties_common_tones"
      ],
      "version": 1
    },
    {
      "id": "arrangement.bass_stays_in_range",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "The bass part stays inside its instrument profile's comfortable range wherever possible.",
      "trigger": {
        "event": "part_generated",
        "role": "bass"
      },
      "conditions": [
        "role_is_bass",
        "voice_exceeds_instrument_range"
      ],
      "effect": {
        "score_delta": -4.0,
        "severity": "major",
        "score_component": "bass_quality"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "berklee-orchestration-2",
          "locator": "Course description"
        }
      ],
      "confidence": 0.85,
      "rationale": "Below the profile's low limit pitch definition collapses on typical playback systems, so the engine should transpose the note up an octave rather than write it.",
      "test_ids": [
        "bass_within_configured_range",
        "bass_octave_folded_when_too_low"
      ],
      "version": 1
    },
    {
      "id": "arrangement.sub_register_carries_root_only",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "In the sub-bass register only the root should sound; thirds and extensions become mud.",
      "trigger": {
        "event": "part_generated",
        "role": "bass"
      },
      "conditions": [
        "role_is_bass",
        "register_is_low"
      ],
      "effect": {
        "score_delta": -3.0,
        "severity": "moderate",
        "score_component": "bass_quality"
      },
      "profiles": [
        "electronic_loop",
        "drum_and_bass",
        "pop_rock",
        "neo_soul_rnb",
        "cinematic"
      ],
      "exceptions": [
        "intentional_cluster"
      ],
      "source_refs": [
        {
          "source_id": "berklee-orchestration-2",
          "locator": "Course description"
        }
      ],
      "confidence": 0.8,
      "rationale": "The low-interval-limit data already encodes the general case; this rule states the specific consequence for the part that lives there.",
      "test_ids": [
        "sub_bass_root_only"
      ],
      "version": 1
    },
    {
      "id": "arrangement.phrases_need_rests",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "A part that never rests across a whole phrase flattens the arrangement.",
      "trigger": {
        "event": "part_generated"
      },
      "conditions": [
        "phrase_contains_no_rest"
      ],
      "effect": {
        "score_delta": -2.0,
        "severity": "minor",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "role_is_pad_or_sustained",
        "pedal_point_is_active"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Formal contrast"
        }
      ],
      "confidence": 0.75,
      "rationale": "Strategic silence is a contrast device on the same footing as register and density, and it is the one most often forgotten by generators.",
      "test_ids": [
        "sparse_profile_contains_rests",
        "strategic_silence_present"
      ],
      "version": 1
    },
    {
      "id": "arrangement.doubling_is_declared_not_incidental",
      "domain": "arrangement",
      "kind": "arrangement_heuristic",
      "summary": "Octave and unison doubling between parts is only acceptable when the pattern declares it.",
      "trigger": {
        "event": "arrangement_plan"
      },
      "conditions": [
        "doubling_is_allowed_for_role"
      ],
      "effect": {
        "score_delta": 1.5,
        "severity": "minor",
        "score_component": "arrangement_clarity"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "berklee-orchestration-2",
          "locator": "Course description"
        }
      ],
      "confidence": 0.75,
      "rationale": "Declared doubling adds weight; incidental doubling removes a part. The distinction is data, so the trace can say which one happened.",
      "test_ids": [
        "doubling_limited_by_role"
      ],
      "version": 1
    },
    {
