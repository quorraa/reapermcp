    {
      "id": "voice_leading.parallel_perfect_fifths",
      "domain": "voice_leading",
      "kind": "style_sensitive_preference",
      "summary": "Two voices moving in parallel perfect fifths reduce voice independence.",
      "trigger": {
        "event": "voice_pair_motion",
        "interval": "P5"
      },
      "conditions": [
        "motion_is_parallel",
        "interval_is_perfect_fifth_or_octave"
      ],
      "effect": {
        "score_delta": -4.0,
        "severity": "major",
        "score_component": "voice_leading"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "cinematic",
        "jazz_standard"
      ],
      "exceptions": [
        "quartal_or_planing_context",
        "intentional_cluster"
      ],
      "source_refs": [
        {
          "source_id": "mt21c",
          "locator": "Voice leading"
        }
      ],
      "confidence": 0.9,
      "rationale": "The penalty is large in strict profiles and absent in power-chord, planing and quartal contexts, where parallel perfect intervals are the intended sound rather than an error.",
      "test_ids": [
        "parallel_fifths_penalised_strict",
        "parallel_fifths_free_in_power_profile"
      ],
      "version": 1
    },
    {
