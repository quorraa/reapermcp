    {
      "id": "looping.bass_continuity_across_wrap",
      "domain": "looping",
      "kind": "loop_integrity",
      "summary": "A large bass leap across the wrap makes the loop point audible.",
      "trigger": {
        "event": "loop_boundary"
      },
      "conditions": [
        "bass_leaps_across_wrap"
      ],
      "effect": {
        "score_delta": -3.0,
        "severity": "moderate",
        "score_component": "loop_compatibility"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "final_chord_is_dominant_function",
