    {
      "id": "looping.pedal_continues_across_wrap",
      "domain": "looping",
      "kind": "loop_integrity",
      "summary": "A pedal or drone that stops at the loop end and restarts creates an audible seam.",
      "trigger": {
        "event": "loop_boundary"
      },
      "conditions": [
