{
  "schema_version": "1.0.0",
  "items": [
    {
      "id": "looping.no_hanging_note_past_loop_end",
      "domain": "looping",
      "kind": "loop_integrity",
      "summary": "A generated note must not sound past the loop end without an explicit carry or split policy.",
      "trigger": {
        "event": "loop_boundary"
      },
      "conditions": [
        "note_extends_past_loop_end"
      ],
      "effect": {
        "score_delta": -20.0,
        "severity": "major",
        "score_component": "loop_compatibility"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [
        "note_carry_policy_is_explicit"
      ],
      "source_refs": [
        {
          "source_id": "reaper-reascript-help",
          "locator": "MIDI functions"
        }
      ],
      "confidence": 0.95,
      "rationale": "A hanging note is audible as a stuck voice on the first repeat. Carrying it is a valid choice, but only when the caller asked for it.",
      "test_ids": [
        "hanging_note_detected",
        "carry_policy_allows_overhang"
      ],
      "version": 1
    },
    {
      "id": "looping.pickup_wraps_or_duplicates",
      "domain": "looping",
      "kind": "loop_integrity",
      "summary": "Material before the first downbeat must be either wrapped into the loop tail or duplicated, never silently dropped.",
      "trigger": {
        "event": "loop_boundary"
      },
      "conditions": [
        "pickup_is_present"
      ],
      "effect": {
        "score_delta": -6.0,
