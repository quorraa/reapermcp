    {
      "id": "looping.exact_length_is_preserved",
      "domain": "looping",
      "kind": "mathematical_invariant",
      "summary": "The generated loop span must equal the requested loop length exactly, with no floating-point drift.",
      "trigger": {
        "event": "loop_boundary"
      },
      "conditions": [
        "loop_length_is_exact"
      ],
      "effect": {
        "score_delta": -1000.0,
        "severity": "major",
        "score_component": "loop_compatibility"
      },
      "profiles": [
        "common_practice",
        "strict_counterpoint",
        "jazz_standard",
        "blues",
        "pop_rock",
        "neo_soul_rnb",
        "modal_ambient",
        "cinematic",
        "electronic_loop",
        "drum_and_bass"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "reaper-reascript-help",
          "locator": "MIDI functions"
        }
      ],
      "confidence": 1.0,
      "rationale": "Loop boundaries are compared for exact equality, which is why musical time is a normalised rational rather than a float. A drift of one tick compounds on every repeat.",
      "test_ids": [
        "loop_length_exact",
        "loop_boundary_equality_is_exact"
      ],
      "version": 1
    },
    {
      "id": "looping.closed_tonic_prefers_dominant_to_tonic_wrap",
      "domain": "looping",
      "kind": "style_sensitive_preference",
      "summary": "For a closed tonal loop, ending on the dominant and beginning on the tonic makes the wrap sound intended.",
      "trigger": {
        "event": "loop_boundary",
        "loop_intent": "closed_tonic"
      },
      "conditions": [
        "final_chord_is_dominant_function",
        "first_chord_is_tonic_function"
      ],
      "effect": {
        "score_delta": 4.0,
        "severity": "moderate",
        "score_component": "loop_compatibility"
      },
      "profiles": [
        "common_practice",
        "jazz_standard",
        "pop_rock",
        "blues",
        "cinematic",
        "electronic_loop"
      ],
      "exceptions": [
        "modal_center_is_active"
      ],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Harmonic function"
        }
      ],
      "confidence": 0.85,
      "rationale": "The wrap becomes an authentic cadence, which is why turnarounds exist. This is a strong preference for one intent and no requirement at all for the others.",
      "test_ids": [
        "v_to_i_across_wrap_compatible",
        "closed_tonic_prefers_turnaround"
      ],
      "version": 1
    },
    {
      "id": "looping.modal_drone_does_not_require_dominant",
      "domain": "looping",
      "kind": "style_sensitive_preference",
      "summary": "A modal or drone loop is judged on common tones and pedal continuity, not on dominant-to-tonic motion.",
      "trigger": {
        "event": "loop_boundary",
        "loop_intent": "modal_drone"
      },
      "conditions": [
        "modal_center_is_active",
        "common_tone_retained"
      ],
      "effect": {
        "score_delta": 3.5,
        "severity": "moderate",
        "score_component": "loop_compatibility"
      },
      "profiles": [
        "modal_ambient",
        "electronic_loop",
        "drum_and_bass",
        "cinematic",
        "neo_soul_rnb"
      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Chord-scale theory"
        }
      ],
      "confidence": 0.85,
      "rationale": "Forcing every loop to close on a tonic is the loop-engine equivalent of forcing every passage into a major key. Modal loops close by continuity instead.",
      "test_ids": [
        "modal_drone_no_dominant_required",
        "modal_loop_scored_on_common_tones"
      ],
      "version": 1
    },
    {
      "id": "looping.open_dominant_ends_unresolved",
      "domain": "looping",
      "kind": "style_sensitive_preference",
      "summary": "An open-dominant loop is supposed to end unresolved, so an unresolved tendency tone at the wrap is correct rather than a fault.",
      "trigger": {
        "event": "loop_boundary",
        "loop_intent": "open_dominant"
      },
      "conditions": [
        "final_chord_is_dominant_function",
        "tendency_tone_is_unresolved"
