      ],
      "exceptions": [],
      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Harmonic function"
        }
      ],
      "confidence": 0.85,
      "rationale": "The unresolved-tendency penalty must be suppressed for this intent, otherwise the engine penalises the caller for asking for exactly what it produced.",
      "test_ids": [
        "open_dominant_unresolved_is_ok"
      ],
      "version": 1
    },
    {
      "id": "looping.seamless_color_uses_common_tones",
      "domain": "looping",
      "kind": "style_sensitive_preference",
      "summary": "A seamless-colour loop should share pitch classes across the wrap so the seam is inaudible.",
      "trigger": {
        "event": "loop_boundary",
        "loop_intent": "seamless_color"
      },
      "conditions": [
        "common_tone_available",
        "common_tone_retained"
