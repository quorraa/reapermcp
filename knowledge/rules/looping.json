      "source_refs": [
        {
          "source_id": "open-music-theory",
          "locator": "Harmonic function"
        }
      ],
      "confidence": 0.8,
      "rationale": "The bass is the part a listener uses to locate the beat, so a discontinuity there is far more noticeable than the same leap in an inner voice. A dominant-to-tonic fifth is the intended exception.",
      "test_ids": [
        "bass_discontinuity_detected",
        "bass_fifth_across_wrap_allowed"
      ],
      "version": 1
